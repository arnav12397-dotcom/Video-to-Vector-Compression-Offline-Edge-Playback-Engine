# ==============================================================================
# PROJECT BYTECLASS: BACKEND LLM & COMPILER CONFIGURATION
# ==============================================================================

# 1. (RECOMMENDED) GROQ CLOUD API KEY
# Sign up for a free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# 2. (OPTIONAL) HUGGING FACE API ACCESS TOKEN
# Get a free read token at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_huggingface_token_here

# 3. BACKEND OPEN-SOURCE MODEL SELECTION
# Recommended choices:
#   - Qwen/Qwen2.5-Coder-32B-Instruct  (DEFAULT: Best for 2D spatial math, SVG vectors & XML tags)
#   - meta-llama/Llama-3.3-70B-Instruct (Best for pedagogical explanations & teaching intuition)
#   - deepseek-ai/DeepSeek-R1-Distill-Qwen-32B (Deep scientific reasoning & multi-step proofs)
#   - mistralai/Mistral-7B-Instruct-v0.3 (Fast lightweight serverless)
MODEL_NAME=Qwen/Qwen2.5-Coder-32B-Instruct

# 4. DEFAULT LESSON DURATION (MINUTES)
# Default duration for pedagogical lectures (e.g., 4.0 = ~4 minutes, 6 chapters)
DEFAULT_DURATION_MINUTES=4.0

